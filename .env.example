# Copy to .env. Every value is optional for local development.

# SQLite (default) — file is created on first use.
DATABASE_URL=sqlite:///data/processed/territory.db
# PostgreSQL/PostGIS via docker-compose:
# DATABASE_URL=postgresql+psycopg://bizgrips:bizgrips@localhost:5432/bizgrips_territory

# Census API key (free: https://api.census.gov/data/key_signup.html). Without one the census
# import reads the ACS Summary File downloads instead of the Data API (same estimates).
CENSUS_API_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
